      "record_id": "EAA6dZC4qoAYkpxRp71ck076nfc",
      "text": "阶段二：规划器决策",
      "type": "block docx-heading4-block"
    },
    {
      "id": "165",
      "images": 0,
      "links": [],
      "position": 7966.78125,
      "record_id": "YyTcdrNF6o1bKlxSi7AcVhOSn7c",
