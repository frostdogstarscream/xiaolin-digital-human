[Unit]
Description=Xiaolin SSH external TCP 6025 to internal TCP 22
After=network-online.target ufw.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/xiaolin/deployment/ssh-portmap.sh start
ExecStop=/opt/xiaolin/deployment/ssh-portmap.sh stop
TimeoutStartSec=45
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
